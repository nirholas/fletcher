{
  "name": "fletcher",
  "private": true,
  "version": "0.1.0",
  "description": "Turbos and floors for tokenized stocks on Robinhood Chain",
  "type": "module",
  "scripts": {
    "build": "node scripts/extract-abis.mjs && pnpm -r build",
    "test": "pnpm test:contracts && pnpm -r test && pnpm check:docs",
    "test:contracts": "forge test --root contracts",
    "test:fork": "forge test --root contracts --match-path 'test/fork/*'",
    "check:docs": "node scripts/check-docs.mjs",
    "abis": "node scripts/extract-abis.mjs",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter @fletcher/web dev"
  },
  "packageManager": "pnpm@10.32.1",
  "license": "MIT"
}
